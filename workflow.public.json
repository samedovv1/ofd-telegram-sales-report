        272
      ],
      "name": "Get Document Info"
    },
    {
      "parameters": {
        "jsCode": "const documents = $input.all();\n\n// Данные смены\nconst shiftData = $('Get Shift Info').first().json;\nconst shift = shiftData.shift ?? shiftData;\n\nconst income = shift.income ?? {};\nconst incomeReturn = shift.incomeReturn ?? {};\n\nconst products = new Map();\n\nfor (const item of documents) {\n  const doc = item.json.document;\n\n  if (!doc || typeof doc !== 'object') {\n    continue;\n  }\n\n  // Тег 1059 — позиции чека\n  let receiptItems = doc['1059'] ?? [];\n\n  // На случай, если в чеке всего одна позиция\n  if (!Array.isArray(receiptItems)) {\n    receiptItems = [receiptItems];\n  }\n\n  for (const position of receiptItems) {\n    const quantity = Number(position['1023'] ?? 0);\n    const name = String(position['1030'] ?? 'Без названия').trim();\n    const sumKopecks = Number(position['1043'] ?? 0);\n\n    // ВАЖНО: нулевые позиции тоже сохраняем\n    if (!products.has(name)) {\n      products.set(name, {\n        quantity: 0,\n        sum: 0,\n      });\n    }\n\n    const product = products.get(name);\n\n    product.quantity += quantity;\n    product.sum += sumKopecks;\n  }\n}\n\nfunction formatMoney(kopecks) {\n  return new Intl.NumberFormat('ru-RU', {\n    maximumFractionDigits: 2,\n  }).format(kopecks / 100);\n}\n\nfunction formatQuantity(quantity) {\n  return new Intl.NumberFormat('ru-RU', {\n    maximumFractionDigits: 3,\n  }).format(quantity);\n}\n\n// Дата отчёта\nconst openDate = shift.openDateTime.slice(0, 10);\nconst [year, month, day] = openDate.split('-');\n\nconst reportDate = `${day}.${month}.${year}`;\n\n// Формируем список товаров\nconst lines = [];\n\nfor (const [name, data] of products) {\n  lines.push(\n    `${name} — ${formatQuantity(data.quantity)} — ${formatMoney(data.sum)} ₽`\n  );\n}\n\n// Финансовые итоги\nconst revenue =\n  Number(income.total ?? 0) -\n  Number(incomeReturn.total ?? 0);\n\nconst cash =\n  Number(income.cash ?? 0) -\n  Number(incomeReturn.cash ?? 0);\n\nconst electronic =\n  Number(income.electronic ?? 0) -\n  Number(incomeReturn.electronic ?? 0);\n\nconst receiptCount =\n  Number(income.receiptCount ?? 0);\n\nconst report = [\n  `📊 Продажи за ${reportDate}`,\n  shift.cashier ? `Продавец: ${shift.cashier}` : '',\n  '',\n  ...lines,\n  '',\n  `💰 Выручка: ${formatMoney(revenue)} ₽`,\n  `💵 Наличные: ${formatMoney(cash)} ₽`,\n  `💳 Безнал: ${formatMoney(electronic)} ₽`,\n  `🧾 Чеков: ${receiptCount}`,\n]\n  .filter(Boolean)\n  .join('\\n');\n\nreturn [\n  {\n    json: {\n      report,\n      revenue: revenue / 100,\n      cash: cash / 100,\n      electronic: electronic / 100,\n      receiptCount,\n      products: Object.fromEntries(products),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        272
